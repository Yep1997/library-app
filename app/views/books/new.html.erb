<% content_for :title, "Add book" %>

<%= link_to "← All books", books_path, class: "back-link" %>

<div class="page-header">
  <h1>Add book</h1>
</div>

<section class="card card--padded card--narrow">
  <% if @errors.any? %>
    <ul class="errors">
      <% @errors.each do |attribute, messages| %>
        <% messages.each do |message| %>
          <li><%= attribute.to_s.humanize %> <%= message %></li>
        <% end %>
      <% end %>
    </ul>
  <% end %>

  <%= form_with scope: :book, url: books_path, class: "form" do |form| %>
    <div class="field">
      <%= form.label :serial_number %>
      <%= form.text_field :serial_number, value: @attributes[:serial_number], inputmode: "numeric", maxlength: 6 %>
    </div>
    <div class="field">
      <%= form.label :title %>
      <%= form.text_field :title, value: @attributes[:title] %>
    </div>
    <div class="field">
      <%= form.label :author %>
      <%= form.text_field :author, value: @attributes[:author] %>
    </div>
    <%= form.submit "Add book", class: "button button--primary" %>
  <% end %>
</section>
