<% content_for :title, @book.title %>

<%= link_to "← All books", books_path, class: "back-link" %>

<div class="page-header">
  <div>
    <h1><%= @book.title %></h1>
    <p class="subtitle"><%= @book.author %></p>
  </div>
  <span class="badge badge--<%= @book.status %>"><%= @book.status.to_s.humanize %></span>
</div>

<section class="card card--padded book-panel">
  <dl class="details">
    <dt>Serial number</dt>
    <dd class="mono"><%= @book.serial_number %></dd>
  </dl>

  <div class="actions">
    <% if @book.status == :available %>
      <%= form_with url: book_status_path(@book.serial_number), method: :patch, class: "lend-form" do |form| %>
        <%= form.hidden_field :status, value: "borrowed" %>
        <%= form.label :card_number, "Reader" %>
        <%= form.select :card_number, @readers.map { |reader| [ "#{reader.full_name} (#{reader.card_number})", reader.card_number ] } %>
        <%= form.submit "Lend book", class: "button button--primary" %>
      <% end %>
    <% else %>
      <%= button_to "Mark as returned", book_status_path(@book.serial_number), method: :patch, params: { status: "available" }, class: "button button--primary" %>
    <% end %>

    <%= button_to "Delete book", book_path(@book.serial_number), method: :delete, class: "button button--danger" %>
  </div>
</section>

<h2>Borrowing history</h2>

<section class="card">
  <% if @book.loans.any? %>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Reader</th>
            <th>Borrowed at</th>
            <th>Due on</th>
            <th>Returned at</th>
          </tr>
        </thead>
        <tbody>
          <% @book.loans.each do |loan| %>
            <tr>
              <td>
                <span class="reader-name"><%= loan.borrower.full_name %></span>
                <span class="muted"><%= loan.borrower.card_number %> · <%= loan.borrower.email %></span>
              </td>
              <td class="nowrap"><%= l(loan.borrowed_at, format: :long) %></td>
              <td class="nowrap"><%= l(loan.due_on, format: :long) %></td>
              <td class="nowrap">
                <% if loan.returned_at %>
                  <%= l(loan.returned_at, format: :long) %>
                <% else %>
                  <span class="badge badge--borrowed">Not returned yet</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="empty">This book has not been borrowed yet.</p>
  <% end %>
</section>
