<% content_for :title, "Books" %>

<h1>Books</h1>

<%= link_to "Add book", new_book_path %>

<table>
  <thead>
    <tr>
      <th>Serial number</th>
      <th>Title</th>
      <th>Author</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
    <% @books.each do |book| %>
      <tr>
        <td><%= book.serial_number %></td>
        <td><%= link_to book.title, book_path(book.serial_number) %></td>
        <td><%= book.author %></td>
        <td class="status status--<%= book.status %>"><%= book.status.to_s.humanize %></td>
      </tr>
    <% end %>
  </tbody>
</table>
